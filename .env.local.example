# Copy this file to .env.local for local testing, and set the same
# variables in your Vercel project's Environment Variables once deployed.
# See BOOKING_SETUP.md for how to get these values.

GOOGLE_SERVICE_ACCOUNT_CLIENT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEETS_SHEET_ID=
GOOGLE_CALENDAR_ID=

# Powers camp registration emails: the new-registration notice to you, the
# parent's payment instructions, the payment-review alerts, and the parent's
# confirmation once you have verified their payment in your bank account.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# A long, unique password of your choosing — protects /admin/camp-rosters, where
# you review and confirm payments and download the printable rosters. Five wrong
# attempts lock the login for 15 minutes; payment actions ask for it again.
ADMIN_PASSWORD=

# The camp registration database: Neon's "pooled connection" string
# (see BOOKING_SETUP.md, Step 6). For local testing use a throwaway local Postgres.
DATABASE_URL=

# --- Interac e-Transfer payments (see docs/PAYMENT_REVIEW_RUNBOOK.md) ---

# Signs the private link each parent gets for their reservation page. Any long
# random string (32+ characters). REQUIRED in production. Changing it makes
# every link already emailed to parents stop working.
REGISTRATION_LINK_SECRET=

# The address parents e-Transfer to. Leave empty to use the business email.
ETRANSFER_EMAIL=

# Set to true ONLY if that address has Autodeposit turned on at your bank
# (so no security question is needed). Leave unset otherwise.
ETRANSFER_AUTODEPOSIT=

# Who receives the payment-review alerts, comma-separated. Defaults to the
# business email. Add a backup person so an alert never depends on one inbox.
ADMIN_ALERT_EMAILS=

# Protects the scheduled payment-review check (/api/cron/payment-review). Any
# long random string. Only needed once a scheduler is switched on.
CRON_SECRET=
